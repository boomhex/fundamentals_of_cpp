#include <string>

using namespace std;

struct ReturnValues
{
    bool ok = false;    // true if requested arg exists
    size_t nr = 0;      // requested argument number
    string value;  // requested argument value or empty string
};

// Function prototypes
ReturnValues combine(size_t argc, char **argv);
bool structCall(size_t argc, char **argv);
void boundCall(size_t argc, char **argv);
void printResult(ReturnValues const &result);
